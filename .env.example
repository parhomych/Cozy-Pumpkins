NODE_ENV=development
HOST=127.0.0.1
PORT=3000
SESSION_SECRET=replace_with_long_random_secret
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_key
DATABASE_PATH=./data/cozy-pumpkins.sqlite

PUMPKIN_CURRENCY=RUB
STAGE_2_THRESHOLD=300
STAGE_3_THRESHOLD=1000
STAGE_4_THRESHOLD=3000

SCENE_WIDTH=1920
SCENE_HEIGHT=1080
GROUND_Y=1080
PUMPKIN_PADDING=65

# Twitch OAuth app. Register this exact callback URL in the Twitch developer
# console. The broadcaster must authorize channel:read:redemptions.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback
# Twitch channel reward mappings are configured by reward in the admin panel.
# These environment values are retained as initial defaults for existing setups.
TWITCH_REWARD_INFLATE_ID=
TWITCH_REWARD_JUMP_ON_ID=
TWITCH_REWARD_MORPH_FLY_ID=
TWITCH_REWARD_BAT_ID=
TWITCH_REWARD_GHOST_ID=
TWITCH_REWARD_PUMPKIN_TOWER_ID=

# DonationAlerts OAuth app. Register the exact callback URL; the app requests
# identity and donation-event subscription scopes.
DA_CLIENT_ID=
DA_CLIENT_SECRET=
DA_REDIRECT_URI=http://localhost:3000/api/auth/donationalerts/callback

# DonatEx OAuth app. The account must authorize the donations.subscribe scope.
DONATEX_CLIENT_ID=
DONATEX_CLIENT_SECRET=
DONATEX_REDIRECT_URI=http://localhost:3000/api/auth/donatex/callback

# Meme Alerts OAuth app. API access may require registration through support.
MEMEALERTS_CLIENT_ID=
MEMEALERTS_CLIENT_SECRET=
MEMEALERTS_REDIRECT_URI=http://localhost:3000/api/auth/memealerts/callback
